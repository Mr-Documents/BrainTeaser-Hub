# ---------------------------------------------------------------------------
# Brain Teaser Hub - environment
# Copy to `.env` and fill in. Everything here has a working default except the
# Supabase credentials and the admin token.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- storage ---------------------------------------------------------------
# Leave DATA_DRIVER unset to auto-select: Supabase when credentials are present,
# otherwise the JSON files under data/. Force it with json | supabase | memory.
# DATA_DRIVER=supabase

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key. Server-side only - it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- admin -----------------------------------------------------------------
# Required to reach /admin once ADMIN_AUTH_REQUIRED is on (automatic in production).
ADMIN_TOKEN=change-me-to-a-long-random-string
# ADMIN_AUTH_REQUIRED=true
ADMIN_SESSION_HOURS=12

# --- gameplay --------------------------------------------------------------
ATTEMPT_TTL_MINUTES=240
MAX_ACTIVE_ATTEMPTS=20000

# --- rate limiting (on by default in production) ---------------------------
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_MAX=40
RATE_LIMIT_API_MAX=240

# --- misc ------------------------------------------------------------------
# Absolute origin, used for canonical/share URLs when behind a proxy.
# PUBLIC_BASE_URL=https://brainteaserhub.example.com
