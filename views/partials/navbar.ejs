<% var active = typeof navActive !== 'undefined' ? navActive : ''; %>
<a class="skip-link" href="#main">Skip to content</a>

<header class="navbar" data-nav>
  <div class="navbar__inner shell">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">🧠</span>
      <span class="brand__text">
        <span class="brand__name"><%= site.name %></span>
        <span class="brand__tag"><%= site.tagline %></span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul class="nav__list">
        <li><a class="nav__link<%= active === 'play' ? ' is-active' : '' %>" href="/play"<%- active === 'play' ? ' aria-current="page"' : '' %>>Play</a></li>
        <li><a class="nav__link<%= active === 'daily' ? ' is-active' : '' %>" href="/daily"<%- active === 'daily' ? ' aria-current="page"' : '' %>>Daily</a></li>
        <li><a class="nav__link<%= active === 'leaderboard' ? ' is-active' : '' %>" href="/leaderboard"<%- active === 'leaderboard' ? ' aria-current="page"' : '' %>>Leaderboard</a></li>
        <li><a class="nav__link<%= active === 'how' ? ' is-active' : '' %>" href="/how-it-works"<%- active === 'how' ? ' aria-current="page"' : '' %>>Scoring</a></li>
        <li><a class="nav__link nav__link--muted<%= active === 'admin' ? ' is-active' : '' %>" href="/admin"<%- active === 'admin' ? ' aria-current="page"' : '' %>>Studio</a></li>
      </ul>
      <div class="nav__cta">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme" title="Switch colour theme">
          <span data-theme-icon aria-hidden="true">◐</span>
        </button>
        <% if (typeof isSignedIn !== 'undefined' && isSignedIn) { %>
          <a class="nav-account<%= active === 'account' ? ' is-active' : '' %>" href="/profile" title="Your profile">
            <span class="nav-account__avatar" aria-hidden="true"><%= currentPlayer.displayName.trim().charAt(0).toUpperCase() %></span>
            <span class="nav-account__text">
              <span class="nav-account__name"><%= currentPlayer.displayName %></span>
              <span class="nav-account__meta"><%= Number(currentPlayer.totalScore || 0).toLocaleString('en-US') %> pts<% if (currentPlayer.currentStreak > 0) { %> · <%= currentPlayer.currentStreak %>🔥<% } %></span>
            </span>
          </a>
        <% } else { %>
          <a class="btn btn--ghost btn--sm" href="/signin">Sign in</a>
          <a class="btn btn--primary btn--sm" href="/play">Start solving</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
